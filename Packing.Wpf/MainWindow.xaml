<Window x:Class="Packing.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Packing.Wpf"
        Title="Двумерная упаковка · Вариант 2" Width="1040" Height="760"
        MinWidth="900" MinHeight="660" Background="#F4F1EC" FontFamily="Segoe UI"
        FontSize="14" Foreground="#302D29" Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="TaskInputs">
                            <TextBlock Text="Фигуры" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="1 × 1"/><TextBox x:Name="UnitSquares" Text="12"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="2 × 2"/><TextBox x:Name="DoubleSquares" Text="8"/></StackPanel>
                                <StackPanel><TextBlock Text="3 × 3"/><TextBox x:Name="TripleSquares" Text="5"/></StackPanel>
                            </UniformGrid>
                            <CheckBox x:Name="UseOblongTiles" Content="Прямоугольники" Margin="0,2,0,10" Checked="OnRectangleModeChanged" Unchecked="OnRectangleModeChanged"/>
                            <UniformGrid x:Name="OblongInputs" Columns="2" Visibility="Collapsed">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="1 × 2"/><TextBox x:Name="TallDominoes" Text="0"/></StackPanel>
                                <StackPanel><TextBlock Text="2 × 1"/><TextBox x:Name="WideDominoes" Text="0"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="1 × 3"/><TextBox x:Name="TallTriples" Text="0"/></StackPanel>
                                <StackPanel><TextBlock Text="3 × 1"/><TextBox x:Name="WideTriples" Text="0"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Поиск" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Популяция"/><TextBox x:Name="PoolSizeInput" Text="120"/></StackPanel>
                                <StackPanel><TextBlock Text="Поколения"/><TextBox x:Name="EpochLimitInput" Text="1000"/></StackPanel>
                                <StackPanel><TextBlock Text="Мутация"/><TextBox x:Name="VariationInput" Text="0,25"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Потоки"/><TextBox x:Name="ParallelLimitInput"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Потоки для сравнения" Margin="0,16,0,0"/>
                            <TextBox x:Name="ComparisonInput"/>
                        </StackPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="RunSearch" Content="Запустить" Background="{StaticResource Accent}" Foreground="White" Click="OnStart"/>
                            <Button x:Name="HaltSearch" Content="Остановить" IsEnabled="False" Click="OnStop"/>
                        </WrapPanel>
                        <CheckBox x:Name="UseWorkers" Content="Расчёт по сети" Margin="0,12,0,0"/>
                        <Button Content="Серверы и мониторинг" Click="OnNetwork" Margin="0,8,0,0"/>
                        <Button x:Name="MeasureThreads" Content="Сравнить потоки" Click="OnProfile" Margin="0,8,0,0"/>
                        <TextBlock x:Name="IssueLabel" Foreground="#A13C32" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="0" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="ResultLabel" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IterationLabel" Foreground="#756C62" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="0" Padding="14" Margin="0,0,0,14">
                    <local:PackingView x:Name="LayoutCanvas"/>
                </Border>
                <local:ThreadProfileView x:Name="TimingCanvas" Grid.Row="2" Height="180" Visibility="Collapsed"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="ActivityLabel" Grid.Row="1" Text="Готово" Foreground="#756C62" Margin="0,16,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
