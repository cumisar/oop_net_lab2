<Window x:Class="Packing.Wpf.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Серверы и мониторинг" Width="840" Height="550" MinWidth="760" MinHeight="480"
        Background="#F4F1EC" FontFamily="Segoe UI" FontSize="13" Closing="OnClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="EndpointInput" Text="127.0.0.1:5080" Margin="0,4,10,12"/>
            <Button Grid.Column="1" Content="Добавить" Click="OnAdd"/>
            <Button Grid.Column="2" Content="Убрать" Click="OnRemove"/>
            <Button Grid.Column="3" Content="Вкл / выкл" Click="OnToggle"/>
        </Grid>
        <DataGrid x:Name="WorkerTable" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                  SelectionMode="Single" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="210"/>
                <DataGridCheckBoxColumn Header="Вкл" Binding="{Binding Enabled}" Width="40"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="105"/>
                <DataGridTextColumn Header="Пакеты" Binding="{Binding Completed}" Width="60"/>
                <DataGridTextColumn Header="Ошибки" Binding="{Binding Failures}" Width="65"/>
                <DataGridTextColumn Header="мс" Binding="{Binding Milliseconds, StringFormat=F1}" Width="65"/>
                <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="*" MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="ConnectionLabel" Grid.Row="2" Text="" Foreground="#756C62" Margin="0,10,0,10" TextWrapping="Wrap"/>
        <DataGrid x:Name="ActivityTable" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="75"/>
                <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="180"/>
                <DataGridTextColumn Header="Событие" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
